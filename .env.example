# Copy this file to .env.local and fill in the values. NEVER commit real values (.env.* is git-ignored).
# Load them with:  bash scripts/test-all.sh  (it reads .env.local itself)

# --- S3 object storage (values that `neon deploy` wrote into .env.local)
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=seekker-pdfs

# --- PostgreSQL (Neon, or a local Postgres)
# DB_HOST includes the port if needed. Use the DIRECT host (without -pooler): Flyway needs it.
#   Neon:   DB_HOST=ep-xxxx.eu-central-1.aws.neon.tech   DB_SSLMODE=require
#   Local:  DB_HOST=localhost:5433                       DB_SSLMODE=disable
DB_HOST=
DB_NAME=neondb
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
